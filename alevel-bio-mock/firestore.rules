rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Immutable GitHub numeric ID, verified by Firebase Authentication.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'github.com'
        && 'github.com' in request.auth.token.firebase.identities
        && request.auth.token.firebase.identities['github.com'].hasAny(['19434459']);
    }
    function validAttempt() {
      return request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'github.com']
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'examId', 'scoreX10', 'categoryX10',
          'answeredCount', 'durationSeconds', 'autoSubmitted', 'submittedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'examId', 'scoreX10', 'categoryX10',
          'answeredCount', 'durationSeconds', 'autoSubmitted', 'submittedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.examId == 'biology-mock-2570-v1'
        && request.resource.data.scoreX10 is int
        && request.resource.data.scoreX10 >= 0
        && request.resource.data.scoreX10 <= 1000
        && request.resource.data.answeredCount is int
        && request.resource.data.answeredCount >= 0
        && request.resource.data.answeredCount <= 40
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.durationSeconds <= 5400
        && request.resource.data.autoSubmitted is bool
        && request.resource.data.submittedAt == request.time
        && request.resource.data.categoryX10 is map
        && request.resource.data.categoryX10.keys().hasOnly(['eco','cell','human','plant','gene']);
    }
    match /attempts/{attemptId} {
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if validAttempt();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
